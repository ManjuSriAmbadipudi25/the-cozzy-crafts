{
  "entities": {
    "Product": {
      "title": "Product",
      "description": "A luxury handmade craft product offered for sale",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "slug": { "type": "string" },
        "description": { "type": "string" },
        "price": { "type": "number" },
        "images": { "type": "array" },
        "category": { "type": "string" },
        "stock": { "type": "number" },
        "rating": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "name", "slug", "price", "images", "category", "stock"]
    },
    "Category": {
      "title": "Category",
      "description": "A product category classification",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "slug": { "type": "string" },
        "image": { "type": "string" }
      },
      "required": ["id", "name", "slug", "image"]
    },
    "Banner": {
      "title": "Banner",
      "description": "An editable hero banner shown on the homepage",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "subtitle": { "type": "string" },
        "image": { "type": "string" },
        "link": { "type": "string" },
        "isActive": { "type": "boolean" }
      },
      "required": ["id", "title", "image", "link", "isActive"]
    },
    "Order": {
      "title": "Order",
      "description": "An order placed by a customer",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "customerName": { "type": "string" },
        "customerEmail": { "type": "string" },
        "shippingAddress": { "type": "string" },
        "items": { "type": "array" },
        "totalAmount": { "type": "number" },
        "status": { "type": "string", "enum": ["pending", "processing", "shipped", "delivered", "cancelled"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "customerName", "customerEmail", "shippingAddress", "items", "totalAmount", "status", "createdAt"]
    },
    "Review": {
      "title": "Review",
      "description": "A customer review left on a product",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "productId": { "type": "string" },
        "userName": { "type": "string" },
        "rating": { "type": "number" },
        "comment": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "productId", "userName", "rating", "comment", "createdAt"]
    }
  },
  "firestore": {
    "/products/{productId}": {
      "schema": "Product",
      "description": "Handmade premium products collection"
    },
    "/categories/{categoryId}": {
      "schema": "Category",
      "description": "Product categories categories collection"
    },
    "/banners/{bannerId}": {
      "schema": "Banner",
      "description": "Configurable sliders/banners info"
    },
    "/orders/{orderId}": {
      "schema": "Order",
      "description": "E-commerce customer orders placed"
    },
    "/reviews/{reviewId}": {
      "schema": "Review",
      "description": "Customer feedback and ratings on products"
    }
  }
}
